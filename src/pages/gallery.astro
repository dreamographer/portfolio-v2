---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GridPaper from '../components/GridPaper.astro';
import Hand from '../components/Hand.astro';
import HandLink from '../components/HandLink.astro';
import Marker from '../components/Marker.astro';
import Mono from '../components/Mono.astro';
import { NB } from '../lib/notebook';
import { img } from '../lib/img.mjs';

const rawItems = await getCollection('gallery');

// Every photo gets resized copies (see src/lib/img.mjs): three square crops
// for the grid tile's srcset, and one capped at 1600px for the lightbox.
// The originals in public/media are never sent to the browser.
const tiles = await Promise.all(
  rawItems
    .filter((it) => it.data.image)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (it) => {
      const src = it.data.image as string;
      const [s240, s480, s720, full] = await Promise.all([
        img(src, 'sq240'),
        img(src, 'sq480'),
        img(src, 'sq720'),
        img(src, 'full'),
      ]);
      return {
        label: it.data.label,
        thumb: s480 as string,
        srcset: `${s240} 240w, ${s480} 480w, ${s720} 720w`,
        full: full as string,
      };
    }),
);

// Tiles above the fold load immediately; the rest wait until scrolled near.
const EAGER = 9;

const viewerData = tiles.map((t) => ({ src: t.full, label: t.label }));
---

<Base title="Gallery · Ashwin KV" description="Photos, screenshots, sketches. A pinboard of stuff I like.">
  <GridPaper size={22} class="gallery-root">

    {/* ─── Header ─── */}
    <header class="detail-header">
      <div class="detail-header-left">
        <HandLink href="/" color={NB.pencil}>
          <Hand size={18} color={NB.pencil}>← back to home</Hand>
        </HandLink>
        <Marker size="clamp(36px, 7vw, 60px)" as="h1" style="display:block; margin-top:2px;">Gallery.</Marker>
      </div>
      <Mono size={9} class="detail-header-tag">{tiles.length} posts</Mono>
    </header>

    {/* ─── Content ─── */}
    <div class="gallery-body">
      <Hand size={19} color={NB.inkSoft} as="p" class="gallery-intro">
        Photos, screenshots, sketches. A pinboard of stuff I like.
      </Hand>

      {/* ─── Square grid, 3 across at every width ─── */}
      <ul class="ig-grid">
        {tiles.map((t, i) => (
          <li class="ig-cell">
            <button class="ig-tile" type="button" data-idx={i} aria-label={`View ${t.label} full size`}>
              <img
                src={t.thumb}
                srcset={t.srcset}
                sizes="(min-width: 975px) 309px, 33vw"
                width="480"
                height="480"
                alt={t.label}
                loading={i < EAGER ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="ig-tile-label" aria-hidden="true">{t.label}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    {/* ─── Full preview overlay ─── */}
    <div
      class="gv"
      id="gv"
      role="dialog"
      aria-modal="true"
      aria-label="Photo preview"
      hidden
    >
      <button class="gv-close" type="button" data-gv-close aria-label="Close preview">✕</button>
      <button class="gv-nav gv-prev" type="button" data-gv-prev aria-label="Previous photo">←</button>
      <button class="gv-nav gv-next" type="button" data-gv-next aria-label="Next photo">→</button>
      <figure class="gv-figure">
        <img class="gv-img" id="gvImg" alt="" />
        <figcaption class="gv-cap">
          <span id="gvCap"></span>
          <span class="gv-count" id="gvCount"></span>
        </figcaption>
      </figure>
    </div>

    <script type="application/json" id="gvData" set:html={JSON.stringify(viewerData)} />

  </GridPaper>
</Base>

<script>
  // Photo viewer: tapping a tile opens the full overlay. Written to survive
  // ClientRouter navigations: init() re-runs per page, while document-level
  // listeners are bound exactly once.
  type Item = { src: string; label: string };

  interface ViewerState {
    items: Item[];
    gv: HTMLElement | null;
    gvImg: HTMLImageElement | null;
    gvCap: HTMLElement | null;
    gvCount: HTMLElement | null;
    current: number;
    lastTrigger: HTMLElement | null;
  }

  const S: ViewerState = {
    items: [],
    gv: null,
    gvImg: null,
    gvCap: null,
    gvCount: null,
    current: -1,
    lastTrigger: null,
  };

  // Warm the cache for a photo so stepping to it is instant.
  function preload(i: number) {
    const n = S.items.length;
    if (!n) return;
    new Image().src = S.items[(i + n) % n].src;
  }

  function show(i: number) {
    if (!S.items.length || !S.gvImg) return;
    S.current = (i + S.items.length) % S.items.length;
    const it = S.items[S.current];
    S.gvImg.src = it.src;
    S.gvImg.alt = it.label;
    if (S.gvCap) S.gvCap.textContent = it.label;
    if (S.gvCount) S.gvCount.textContent = `${S.current + 1} / ${S.items.length}`;
    preload(S.current + 1);
    preload(S.current - 1);
  }

  function openViewer(i: number, trigger: HTMLElement | null) {
    if (!S.gv) return;
    S.lastTrigger = trigger;
    show(i);
    S.gv.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    (S.gv.querySelector('[data-gv-close]') as HTMLElement | null)?.focus();
  }

  function closeViewer() {
    if (!S.gv) return;
    S.gv.hidden = true;
    document.documentElement.style.overflow = '';
    S.lastTrigger?.focus();
    S.lastTrigger = null;
  }

  function init() {
    // Reset state: the previous page's nodes are gone after a swap.
    S.items = [];
    S.current = -1;
    S.lastTrigger = null;

    const dataEl = document.getElementById('gvData');
    const grid = document.querySelector<HTMLElement>('.ig-grid');
    S.gv = document.getElementById('gv');
    S.gvImg = document.getElementById('gvImg') as HTMLImageElement | null;
    S.gvCap = document.getElementById('gvCap');
    S.gvCount = document.getElementById('gvCount');

    if (!dataEl || !grid || !S.gv || !S.gvImg) return; // not the gallery page

    try {
      S.items = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }
    if (!S.items.length) return;

    S.gv.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === S.gv || t.closest('[data-gv-close]')) return closeViewer();
      if (t.closest('[data-gv-prev]')) return show(S.current - 1);
      if (t.closest('[data-gv-next]')) return show(S.current + 1);
    });

    // One delegated listener for the whole grid instead of one per tile.
    const tileOf = (e: Event) =>
      (e.target as HTMLElement).closest<HTMLElement>('.ig-tile[data-idx]');

    grid.addEventListener('click', (e) => {
      const tile = tileOf(e);
      if (tile) openViewer(Number(tile.dataset.idx), tile);
    });

    // Pointer or keyboard focus landing on a tile means a click is likely:
    // fetch its full-size copy early.
    const warm = (e: Event) => {
      const tile = tileOf(e);
      if (tile) preload(Number(tile.dataset.idx));
    };
    grid.addEventListener('pointerover', warm);
    grid.addEventListener('focusin', warm);
  }

  // Bind page-level listeners once per document, not once per navigation.
  const w = window as unknown as { __galleryViewerBound?: boolean };
  if (!w.__galleryViewerBound) {
    w.__galleryViewerBound = true;

    document.addEventListener('keydown', (e) => {
      if (!S.gv || S.gv.hidden) return;
      if (e.key === 'Escape') closeViewer();
      else if (e.key === 'ArrowLeft') show(S.current - 1);
      else if (e.key === 'ArrowRight') show(S.current + 1);
    });

    // Navigating away with the overlay open must not leave scroll locked.
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.style.overflow = '';
    });

    // Fires on first load and after every ClientRouter navigation.
    document.addEventListener('astro:page-load', init);
  }
</script>

<style>
  .gallery-root {
    min-height: 100vh;
  }

  /* ─── Header ─── */
  .detail-header {
    padding: 16px 18px 14px;
    border-bottom: 1.5px dashed var(--nb-pencil);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .detail-header-left {
    flex: 1;
  }

  .detail-header-tag {
    padding-bottom: 6px;
  }

  /* ─── Body ─── */
  .gallery-body {
    padding: 16px 0 60px;
  }

  .gallery-intro {
    display: block;
    margin: 0 0 14px;
    padding: 0 18px;
  }

  /* ─── Grid: square tiles, 3 across, hairline gaps.
     Edge to edge on phones, capped and centred on wide screens. ─── */
  .ig-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 935px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3px;
  }

  .ig-cell {
    aspect-ratio: 1;
  }

  .ig-tile {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    /* shows while the photo is still loading */
    background: rgba(26, 26, 26, 0.08);
    -webkit-tap-highlight-color: transparent;
  }

  .ig-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ig-tile:focus-visible {
    outline: 2.5px solid var(--nb-ink);
    outline-offset: -2.5px;
  }

  /* Dimmed overlay with the caption, on hover or keyboard focus. */
  .ig-tile-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    background: rgba(0, 0, 0, 0.38);
    color: #fff;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-align: center;
    opacity: 0;
    transition: opacity 0.14s ease;
    pointer-events: none;
  }
  .ig-tile:focus-visible .ig-tile-label {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .ig-tile:hover .ig-tile-label {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ig-tile-label { transition: none; }
  }

  @media (min-width: 880px) {
    .detail-header {
      padding: 20px 60px 16px;
      border-bottom-width: 1.8px;
    }

    .detail-header-tag {
      padding-bottom: 10px;
    }

    .gallery-body {
      padding: 20px 20px 60px;
    }

    .gallery-intro {
      font-size: 24px;
      margin: 0 auto 22px;
      padding: 0;
      max-width: 935px;
    }

    .ig-grid {
      gap: 4px;
    }
  }

  /* ─────────────── Full preview overlay ─────────────── */
  .gv {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(26, 26, 26, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    /* bottom room for the mobile nav row */
    padding: 16px 16px 72px;
  }
  .gv[hidden] { display: none; }

  .gv-figure {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  /* Sized against the viewport, not the parent: the figure's own width comes
     from this image, so a percentage max-width here resolves circularly and
     the image overflows. */
  .gv-img {
    display: block;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    background: #fff;
    padding: 6px;
    border: 1.5px solid #fff;
  }
  .gv-cap {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.82);
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .gv-count { color: rgba(255, 255, 255, 0.5); }

  .gv-close,
  .gv-nav {
    position: absolute;
    background: var(--nb-paper);
    border: 1.5px solid var(--nb-ink);
    color: var(--nb-ink);
    font-family: "JetBrains Mono", monospace;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
  }
  .gv-close {
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    font-size: 15px;
    border-radius: 50%;
  }
  /* Mobile: nav sits in a bottom row so it never covers the photo. */
  .gv-nav {
    bottom: 16px;
    width: 42px;
    height: 42px;
    font-size: 17px;
    border-radius: 50%;
  }
  .gv-prev { left: 16px; }
  .gv-next { right: 16px; }

  .gv-close:focus-visible,
  .gv-nav:focus-visible {
    outline: 2.5px solid var(--nb-yellow, #ffe45c);
    outline-offset: 2px;
  }

  /* Desktop: arrows return to the vertical centre, in gutters beside the photo. */
  @media (min-width: 880px) {
    .gv { padding: 16px; }
    .gv-nav {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
    .gv-prev { left: 26px; }
    .gv-next { right: 26px; }
    .gv-close { top: 20px; right: 22px; }
    .gv-img {
      max-width: calc(100vw - 160px);
      max-height: calc(100vh - 110px);
    }
  }
</style>
